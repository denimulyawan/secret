# ============================================================================
# Contoh konfigurasi. Salin menjadi .env.local lalu isi nilainya.
#
#   !!!  BERKAS INI TIDAK BOLEH MEMUAT NILAI ASLI  !!!
#
# Hanya nama variabel. Nilai asli tidak pernah masuk repo — lihat .gitignore.
# ============================================================================

# --- Google Sheets (tempat data disimpan) ---
# Diambil dari berkas JSON akun layanan yang Anda unduh di Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Isi berkas JSON akun layanan, dalam bentuk base64. Dipakai base64 supaya
# baris baru di dalam kunci tidak rusak saat disalin.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_PRIVATE_KEY_BASE64=
# ID spreadsheet. Ambil dari alamatnya:
#   docs.google.com/spreadsheets/d/<BAGIAN_INI>/edit
SHEET_ID=

# --- Kunci keamanan kredensial ---
# Kunci AES-256 (32 byte, base64). Membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# SIMPAN DI DUA TEMPAT AMAN. Tidak ada pemulihan kalau kunci ini hilang —
# semua password yang tersimpan menjadi tidak bisa dibuka selamanya.
APP_MASTER_KEY=
# Kunci lama, hanya diisi saat proses ganti kunci (opsional).
APP_MASTER_KEY_OLD=

# --- Login Google ---
# Dibuat di Google Cloud Console, jenis "OAuth client ID" → Web application.
# Alamat balikan yang didaftarkan:
#   http://localhost:3000/api/auth/callback     (untuk mencoba di komputer sendiri)
#   https://<domain-anda>/api/auth/callback     (untuk yang dipakai sehari-hari)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Sesi login ---
# Rangkaian acak yang panjang, untuk menandatangani cookie sesi. Membuatnya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Akun administrator pertama. Ditulis ke daftar pengguna sekali saja, saat akun
# ini pertama kali masuk. Setelah itu pengguna ditambah dari dalam aplikasi.
INITIAL_ADMIN_EMAIL=
SESSION_TTL_HOURS=8

# --- Pelindung alamat pemeriksaan alert harian ---
# Rangkaian acak. Dipakai Vercel untuk membuktikan bahwa permintaan datang dari
# penjadwalnya sendiri, bukan dari orang lain.
CRON_SECRET=

# --- Hanya untuk pengembangan di komputer sendiri ---
# Isi "1" untuk bisa membuka aplikasi tanpa login Google saat menjalankan
# "npm run dev". TIDAK PERNAH diisi di Vercel.
DEV_AUTH_BYPASS=
