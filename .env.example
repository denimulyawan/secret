# ============================================================================
# Contoh konfigurasi. Salin menjadi .env.local lalu isi nilainya.
#
#   !!!  BERKAS INI TIDAK BOLEH MEMUAT NILAI ASLI  !!!
#
# Hanya nama variabel. Nilai asli tidak pernah masuk repo — lihat .gitignore.
# ============================================================================

# --- Google Sheets (akses data) ---
# Dari berkas JSON service account yang Anda unduh dari Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key. Simpan dalam bentuk base64 supaya baris barunya tidak rusak:
#   Linux/macOS : base64 -w0 service-account.json
#   PowerShell  : [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_PRIVATE_KEY_BASE64=
# ID spreadsheet. Ambil dari alamatnya:
#   docs.google.com/spreadsheets/d/<BAGIAN_INI>/edit
SHEET_ID=

# --- Kunci keamanan kredensial ---
# Kunci AES-256 (32 byte, base64). Membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# SIMPAN DI DUA TEMPAT AMAN. Tidak ada pemulihan kalau kunci ini hilang —
# semua password yang tersimpan menjadi tidak bisa dibuka selamanya.
APP_MASTER_KEY=
# Kunci lama, hanya diisi saat proses ganti kunci (opsional).
APP_MASTER_KEY_OLD=

# --- Sesi login ---
AUTH_SECRET=
INITIAL_ADMIN_EMAIL=
SESSION_TTL_HOURS=8

# --- Pelindung alamat cron alert (opsional, dipakai di tahap alert) ---
CRON_SECRET=

# --- Hanya untuk pengembangan di komputer sendiri ---
# Isi "1" untuk bisa membuka aplikasi tanpa login Google saat menjalankan
# "npm run dev". TIDAK PERNAH diisi di Vercel.
DEV_AUTH_BYPASS=
